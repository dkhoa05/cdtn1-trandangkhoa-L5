# Sao chép thành .env (cp .env.example .env). Không commit .env. Đổi mọi giá trị khi triển khai thật.
# Khi chạy bằng Docker Compose, DB_HOST và DB_PORT được compose đặt lại (db, 5432) nên không cần sửa hai dòng này.

# Địa chỉ máy chủ PostgreSQL khi chạy trực tiếp bằng Python (dùng 127.0.0.1 thay vì localhost để tránh chậm do IPv6 trên Windows)
DB_HOST=127.0.0.1
# Cổng PostgreSQL
DB_PORT=5432
# Tên CSDL, tự tạo nếu chưa có (Docker: do image postgres tạo)
DB_NAME=cdtn1_l5_dev
# Người dùng PostgreSQL (Docker: được tạo cùng tên này)
DB_USER=postgres
# Mật khẩu PostgreSQL, bắt buộc; giá trị mẫu dùng được cho Docker, hãy đổi khi triển khai thật
DB_PASSWORD=doi_mat_khau_o_day
# Khóa ký token đăng nhập, bắt buộc; ai biết khóa này tự tạo được token giả. Nên dài từ 32 ký tự
SECRET_KEY=doi_chuoi_bi_mat_o_day
# Cổng mở ra máy chủ; bị chiếm thì đổi sang 5001
PORT=5000
# Mức log: INFO (mặc định) hoặc DEBUG khi cần điều tra; log không chứa mật khẩu hay token
LOG_LEVEL=INFO
# Chỉ để 1 trên máy phát triển khi chạy python -m src.app: bật trình gỡ lỗi của Flask. Luôn để 0 ở mọi nơi khác
FLASK_DEBUG=0
